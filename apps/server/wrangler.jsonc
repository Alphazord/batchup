{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "batchup-by-adnanbuilds-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "SESSION_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "realtime-chat-app",
      "database_id": "0245f0e0-2895-4ed9-9e55-c3c68dd57460",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"],
    },
  ],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": false,
  "env": {
    "TOTAL_SHARDS": "7",
    "SHARD_CALLBACK_API_KEY": "",
  },
}